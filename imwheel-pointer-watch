#!/bin/sh

# Runs imwheel only while the mouse pointer is over a GNOME Terminal window
# — not while GNOME Terminal merely has keyboard focus. X11 delivers wheel
# button events (4/5) to whatever window is under the pointer regardless of
# focus, which is why hover-to-scroll normally works everywhere without
# clicking first. An earlier version of this script watched
# _NET_ACTIVE_WINDOW (keyboard focus) instead, so it kept imwheel running
# whenever focus stayed on the terminal — and since imwheel then ate any
# scroll event for a window that didn't match the terminal-only rule in
# ~/.imwheelrc, hovering into Firefox without clicking broke its scrolling.
# Polling the pointer's window matches X11's actual event-routing model;
# there's no property-change notification for "window under the pointer" to
# subscribe to, so this polls instead of using xprop -spy like the old
# focus-based version did.

set -eu

# This runs as a systemd --user service (see
# ~/dotfiles/systemd/imwheel-pointer-watch.service) so it can be
# auto-restarted if it dies, but systemd --user's own environment has no
# DISPLAY or XAUTHORITY — Cinnamon doesn't run the `systemctl --user
# import-environment` step that GNOME sessions do at login. Without them,
# every xdotool/xprop/imwheel call below fails to reach the X server, so
# imwheel never actually starts. Pull the values from an already-running
# session process instead of hardcoding them, since the exact XAUTHORITY
# path is display-manager-specific (GDM here) and could change later.

# Checked on every loop iteration, not just once at startup: at boot,
# systemd --user can start this service before cinnamon-session-binary
# itself is up, so a one-shot check can lose that race and never get
# DISPLAY at all. Once DISPLAY is set this is just one cheap `[ -n ]` test
# per iteration, so retrying costs nothing in steady state.
discover_x_env() {
  if [ -n "${DISPLAY:-}" ]; then
    return 0
  fi
  session_pid=$(pgrep -u "$(id -u)" -f cinnamon-session-binary | head -n1)
  if [ -n "$session_pid" ] && [ -r "/proc/$session_pid/environ" ]; then
    DISPLAY=$(tr '\0' '\n' < "/proc/$session_pid/environ" | sed -n 's/^DISPLAY=//p')
    XAUTHORITY=$(tr '\0' '\n' < "/proc/$session_pid/environ" | sed -n 's/^XAUTHORITY=//p')
    export DISPLAY XAUTHORITY
  fi
}

imwheel_running() {
  pgrep -x imwheel > /dev/null 2>&1
}

sync_imwheel() {
  wid=$(xdotool getmouselocation --shell 2> /dev/null | sed -n 's/^WINDOW=//p')
  class=$(xprop -id "$wid" WM_CLASS 2> /dev/null | sed -n 's/.*"\(.*\)"$/\1/p')
  if [ "$class" = "Gnome-terminal" ]; then
    if ! imwheel_running; then
      imwheel -b "4 5" -f
    fi
  else
    if imwheel_running; then
      imwheel -k -q
    fi
  fi
}

while :; do
  discover_x_env
  sync_imwheel
  sleep 0.1
done
