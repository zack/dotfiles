#!/bin/sh
# Claude wrote this for me, replacing lolcat in the zshrc greeting.
#
# lolcat is a ruby script, and booting ruby costs about 45ms, two thirds of
# which is rubygems scanning the disk for gems the script barely touches. That's
# too expensive for every shell startup (where I want to use it).
#
# This does roughly the same thing lolcat does.
#
# It is not a complete lolcat replacement. No animation, no seed flag, no
# 256-color fallback, and it always colorizes rather than checking whether
# stdout is a terminal. The one call site in zshrc is already guarded on -t 1,
# so I don't care, but that is worth knowing before using it somewhere else.

exec awk -v freq="${1:-0.5}" -v spread=3.0 -v seed="$$" '
  BEGIN { pi = 3.14159265358979 }
  {
    for (i = 1; i <= length($0); i++) {
      n = seed + NR + i / spread
      r = int(sin(freq * n + 0)          * 127 + 128)
      g = int(sin(freq * n + 2 * pi / 3) * 127 + 128)
      b = int(sin(freq * n + 4 * pi / 3) * 127 + 128)
      printf "\033[38;2;%d;%d;%dm%s", r, g, b, substr($0, i, 1)
    }
    printf "\033[0m\n"
  }'
